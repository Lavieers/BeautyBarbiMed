# Skopiuj ten plik jako ".env" i wpisz swoje dane z Supabase
# (Project Settings -> API). Plik ".env" nie trafia do gita.

# Adres projektu, np. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Klucz "anon public" (publiczny z założenia).
# NIGDY nie wpisuj tu klucza "service_role".
VITE_SUPABASE_ANON_KEY=
